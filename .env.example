# Copy to .env.local for development. In production (Dokploy) set these as
# environment variables. The server refuses to start in production if a required
# one is missing (src/lib/env-check.ts).

# ---- Required ----
DATABASE_URL=postgres://mivo:CHANGE_ME@db:5432/mivo
# Generate with: npx auth secret
AUTH_SECRET=
AUTH_TRUST_HOST=true
# Public address, used in every email link. Must be https in production.
APP_URL=https://mivo.lk

# Mail server (e.g. Resend: smtp.resend.com / 465 / resend / <API key>)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=MIVO <orders@mivo.lk>

# Protects POST /api/cron (payment reminders, expiring unpaid orders). 16+ random characters.
CRON_SECRET=

# Product photos and bank slips. MUST be on a persistent volume in production,
# otherwise every redeploy deletes them.
UPLOAD_DIR=/data/uploads

# MIVO's bank account, shown to buyers who pay by bank transfer.
PLATFORM_BANK_NAME=
PLATFORM_BANK_BRANCH=
PLATFORM_BANK_ACCOUNT_NAME=
PLATFORM_BANK_ACCOUNT_NUMBER=
